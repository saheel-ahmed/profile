<script>const TOTAL=159;</script>
<script>
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const RM=matchMedia('(prefers-reduced-motion:reduce)').matches;
const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('show');
  clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),1900)};

const root=document.documentElement;
const setTheme=t=>{root.dataset.theme=t;try{localStorage.setItem('lawha-theme',t)}catch(e){}};
setTheme((()=>{try{return localStorage.getItem('lawha-theme')}catch(e){return null}})()||'dark');
$('#theme').onclick=()=>setTheme(root.dataset.theme==='dark'?'light':'dark');

/* parallax + progress in one rAF loop */
const pars=$$('[data-par]');let ticking=false;
function frame(){
  const h=document.body.scrollHeight-innerHeight;
  $('#bar').style.width=(h>0?scrollY/h*100:0)+'%';
  if(!RM){
    const vh=innerHeight;
    for(const el of pars){
      const r=el.getBoundingClientRect();
      if(r.bottom<-200||r.top>vh+200)continue;
      const off=(r.top+r.height/2-vh/2)*(+el.dataset.speed||-0.04);
      el.style.transform='translate3d(0,'+off.toFixed(1)+'px,0)';
    }
  }
  ticking=false;
}
addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(frame)}},{passive:true});
addEventListener('resize',()=>requestAnimationFrame(frame),{passive:true});
frame();

/* cursor spotlight */
if(!RM&&matchMedia('(hover:hover)').matches){
  document.addEventListener('pointermove',ev=>{
    const c=ev.target.closest('.spot'); if(!c)return;
    const r=c.getBoundingClientRect();
    c.style.setProperty('--mx',(ev.clientX-r.left)+'px');
    c.style.setProperty('--my',(ev.clientY-r.top)+'px');
  },{passive:true});
}

/* search */
const q=$('#q');
function runSearch(){
  const v=q.value.trim().toLowerCase();let total=0;
  $$('.module').forEach(mod=>{
    let shown=0;
    $$('tr[data-blob]',mod).forEach(tr=>{
      const hit=!v||tr.dataset.blob.includes(v);
      tr.hidden=!hit;if(hit)shown++;
      $$('td',tr).forEach(td=>{
        if(td.dataset.raw===undefined)td.dataset.raw=td.textContent;
        const raw=td.dataset.raw;
        if(!v||!hit){td.textContent=raw;return}
        const i=raw.toLowerCase().indexOf(v);
        if(i<0){td.textContent=raw;return}
        td.textContent='';td.append(raw.slice(0,i));
        const m=document.createElement('mark');m.textContent=raw.slice(i,i+v.length);
        td.append(m,raw.slice(i+v.length));
      });
    });
    total+=shown;
    mod.classList.toggle('dim',!!v&&shown===0);
    const em=$('.empty',mod);if(em)em.hidden=!(v&&shown===0);
    if(v){mod.classList.toggle('closed',shown===0);
      $('.fold',mod).setAttribute('aria-expanded',shown===0?'false':'true');}
  });
  $('#count').textContent=v?total+' of '+TOTAL+' matched':TOTAL+' requirements';
}
q.addEventListener('input',runSearch);
addEventListener('keydown',ev=>{
  if(ev.key==='/'&&document.activeElement!==q){ev.preventDefault();q.focus()}
  if(ev.key==='Escape'&&document.activeElement===q){q.value='';runSearch();q.blur()}
});

/* collapse */
$$('.mhead').forEach(h=>{
  const mod=h.closest('.module'),btn=$('.fold',h);
  h.onclick=()=>{const closed=mod.classList.toggle('closed');
    btn.setAttribute('aria-expanded',closed?'false':'true')};
});
$('#expand').onclick=()=>{
  const anyOpen=$$('.module:not(.closed)').length>0;
  $$('.module').forEach(m=>{m.classList.toggle('closed',anyOpen);
    $('.fold',m).setAttribute('aria-expanded',anyOpen?'false':'true')});
  toast(anyOpen?'All modules collapsed':'All modules expanded');
};

/* copy id */
document.addEventListener('click',ev=>{
  const c=ev.target.closest('.c-id');if(!c||!c.closest('.reqs'))return;
  const id=(c.dataset.raw||c.textContent).trim();
  navigator.clipboard?.writeText(id).then(()=>toast(id+' copied'),()=>{});
});

/* ---- navigation ---- */
const nav=$('nav.top'),rail=$('.chiprail'),strip=$('#chips');
let navLock=0,spy=null;
const navH=()=>nav.offsetHeight;
function syncNavH(){
  document.documentElement.style.setProperty('--navh',(navH()+14)+'px');
}
syncNavH();
addEventListener('resize',syncNavH,{passive:true});
if('ResizeObserver' in window)new ResizeObserver(syncNavH).observe(nav);

function railEdges(){
  if(!strip)return;
  const max=strip.scrollWidth-strip.clientWidth;
  rail.classList.toggle('more-l',strip.scrollLeft>4);
  rail.classList.toggle('more-r',strip.scrollLeft<max-4);
}
strip?.addEventListener('scroll',railEdges,{passive:true});
addEventListener('resize',railEdges,{passive:true});
railEdges();

function centreChip(chip){
  if(!chip||!strip)return;
  const target=chip.offsetLeft-(strip.clientWidth-chip.offsetWidth)/2;
  const max=strip.scrollWidth-strip.clientWidth;
  strip.scrollTo({left:Math.max(0,Math.min(target,max)),behavior:RM?'auto':'smooth'});
}
function setActive(id,centre){
  let hit=null;
  $$('.chip').forEach(c=>{
    const on=c.getAttribute('href')==='#mod-'+id;
    c.classList.toggle('active',on);
    if(on)hit=c;
  });
  if(hit&&centre!==false)centreChip(hit);
  return hit;
}
function goTo(id,push){
  const el=document.getElementById('mod-'+id);
  if(!el)return;
  /* a filtered-out module would land on an empty header — clear the filter first */
  if(q.value.trim()&&el.classList.contains('dim')){q.value='';runSearch();}
  el.classList.remove('closed','dim');
  $('.fold',el)?.setAttribute('aria-expanded','true');
  el.classList.add('in');
  setActive(id);
  navLock=1;clearTimeout(window._nl);window._nl=setTimeout(()=>{navLock=0},900);
  const y=el.getBoundingClientRect().top+scrollY-(navH()+14);
  scrollTo({top:y,behavior:RM?'auto':'smooth'});
  if(push)history.replaceState(null,'','#mod-'+id);
}
document.addEventListener('click',ev=>{
  const a=ev.target.closest('a[href^="#mod-"]');
  if(!a)return;
  ev.preventDefault();
  goTo(a.getAttribute('href').slice(5),true);
});
$('#totop').onclick=()=>{
  navLock=1;clearTimeout(window._nl);window._nl=setTimeout(()=>{navLock=0},900);
  $$('.chip').forEach(c=>c.classList.remove('active'));
  strip?.scrollTo({left:0,behavior:RM?'auto':'smooth'});
  scrollTo({top:0,behavior:RM?'auto':'smooth'});
  history.replaceState(null,'',location.pathname+location.search);
};
addEventListener('hashchange',()=>{
  const m=location.hash.match(/^#mod-(\w+)$/);
  if(m)goTo(m[1],false);
});

/* reveal + scrollspy */
if('IntersectionObserver' in window){
  const io=new IntersectionObserver(es=>es.forEach(en=>{
    if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target)}
  }),{rootMargin:'0px 0px -7% 0px'});
  $$('.rv').forEach(n=>io.observe(n));
  spy=new IntersectionObserver(es=>{
    if(navLock)return;
    es.forEach(en=>{if(en.isIntersecting)setActive(en.target.dataset.mod)});
  },{rootMargin:'-'+(navH()+8)+'px 0px -58% 0px'});
  $$('.module').forEach(m=>spy.observe(m));
}else $$('.rv').forEach(n=>n.classList.add('in'));

/* counters */
$$('.kpi .n').forEach(n=>{
  const end=+n.dataset.to;
  if(RM){n.textContent=end;return}
  const t0=performance.now(),d=1100;
  const step=t=>{const p=Math.min((t-t0)/d,1);
    n.textContent=Math.round(end*(1-Math.pow(1-p,3)));
    if(p<1)requestAnimationFrame(step)};
  requestAnimationFrame(step);
});

$('#print').onclick=()=>print();
runSearch();

/* honour a deep link on first load */
(()=>{const m=location.hash.match(/^#mod-(\w+)$/);
  if(m)requestAnimationFrame(()=>goTo(m[1],false));})();
</script>
</body>
