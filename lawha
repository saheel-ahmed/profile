<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#07060F">
<title>Lawha — Product Requirements</title>
<meta name="description" content="Lawha: visual work management. Complete product requirement specification.">
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Noto+Kufi+Arabic:wght@700&display=swap');
:root{
  --v1:#F43F5E; --v2:#A855F7; --v3:#3B82F6; --v4:#22D3EE; --v5:#FBBF24;
  --grad:linear-gradient(100deg,#F43F5E,#A855F7 42%,#3B82F6 78%,#22D3EE);
  --grad-warm:linear-gradient(100deg,#FBBF24,#F43F5E 55%,#A855F7);
  --bg:#07060F; --bg2:#0C0A18; --surface:rgba(255,255,255,.035);
  --ink:#F4F1FB; --muted:#9E97BA; --line:rgba(255,255,255,.11);
  --glow:rgba(168,85,247,.30); --blur:18px;
  --shadow:0 24px 70px -30px rgba(168,85,247,.75);
  --dgm-ink:#EDE9F8; --dgm-slate:#9E97BA; --dgm-hair:rgba(255,255,255,.22);
  --dgm-panel:rgba(255,255,255,.05); --dgm-surface:rgba(255,255,255,.03);
  --dgm-accent:#F43F5E; --dgm-accent-soft:rgba(244,63,94,.22);
  --ui-app:#0F0B1D; --ui-panel:#171029; --ui-card:#1E1636; --ui-line:rgba(255,255,255,.13);
  --ui-text:#EFEBFA; --ui-dim:#948CB4; --ui-ghost:rgba(255,255,255,.13);
  --ui-chip:rgba(255,255,255,.08); --ui-scrim:rgba(7,6,15,.72);
  --hb-slab:rgba(255,255,255,.04); --hb-slabtop:rgba(255,255,255,.07);
  --hb-col:rgba(255,255,255,.05); --hb-chip:rgba(255,255,255,.09);
}
[data-theme="light"]{
  --bg:#F7F4FB; --bg2:#FFFFFF; --surface:rgba(255,255,255,.72);
  --ink:#160F26; --muted:#5F5878; --line:rgba(22,15,38,.13);
  --glow:rgba(168,85,247,.16); --shadow:0 20px 60px -28px rgba(88,28,135,.45);
  --dgm-ink:#251B3A; --dgm-slate:#5F5878; --dgm-hair:rgba(22,15,38,.18);
  --dgm-panel:#F1ECF9; --dgm-surface:#FFFFFF; --dgm-accent-soft:rgba(244,63,94,.14);
  --ui-app:#F6F3FC; --ui-panel:#FFFFFF; --ui-card:#FFFFFF; --ui-line:rgba(22,15,38,.14);
  --ui-text:#1B1330; --ui-dim:#6A6288; --ui-ghost:rgba(22,15,38,.13);
  --ui-chip:rgba(22,15,38,.06); --ui-scrim:rgba(247,244,251,.72);
  --hb-slab:rgba(255,255,255,.72); --hb-slabtop:rgba(22,15,38,.04);
  --hb-col:rgba(22,15,38,.035); --hb-chip:rgba(22,15,38,.07);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:var(--navh,108px);-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);overflow-x:hidden;
  font:400 16px/1.65 'Plus Jakarta Sans',system-ui,sans-serif}
::selection{background:rgba(244,63,94,.35)}

/* ---------- animated field ---------- */
.field{position:fixed;inset:-20vh 0;z-index:-3;pointer-events:none;overflow:hidden}
.field b{position:absolute;display:block;border-radius:50%;filter:blur(100px);opacity:.42;
  animation:float 20s ease-in-out infinite alternate;will-change:transform}
.field b:nth-child(1){width:58vw;height:58vw;left:-16vw;top:-8vw;background:#F43F5E}
.field b:nth-child(2){width:50vw;height:50vw;right:-14vw;top:10vw;background:#A855F7;animation-delay:-6s}
.field b:nth-child(3){width:44vw;height:44vw;left:18vw;top:70vw;background:#3B82F6;animation-delay:-11s;opacity:.34}
.field b:nth-child(4){width:38vw;height:38vw;right:4vw;top:130vw;background:#22D3EE;animation-delay:-3s;opacity:.26}
.field b:nth-child(5){width:34vw;height:34vw;left:6vw;top:190vw;background:#FBBF24;animation-delay:-14s;opacity:.2}
@keyframes float{to{transform:translate3d(5vw,-4vw,0) scale(1.15)}}
.mesh{position:fixed;inset:0;z-index:-2;pointer-events:none;
  background:radial-gradient(ellipse at 50% -10%,transparent 20%,var(--bg) 78%)}
.wrap{max-width:1160px;margin:0 auto;padding:0 30px}
.gt{background:var(--grad);background-size:220% 100%;-webkit-background-clip:text;
  background-clip:text;color:transparent;animation:shift 9s ease-in-out infinite alternate}
@keyframes shift{to{background-position:100% 0}}

/* ---------- glass cards with spotlight ---------- */
.spot{position:relative;isolation:isolate}
.spot::before{content:'';position:absolute;inset:0;border-radius:inherit;z-index:-1;opacity:0;
  transition:opacity .35s ease;pointer-events:none;
  background:radial-gradient(420px circle at var(--mx,50%) var(--my,50%),var(--glow),transparent 70%)}
.spot:hover::before,.spot:focus-within::before{opacity:1}
.glass{background:var(--surface);border:1px solid var(--line);
  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur))}

/* ---------- progress + nav ---------- */
#bar{position:fixed;inset:0 auto auto 0;height:3px;width:0;background:var(--grad);z-index:70;
  box-shadow:0 0 18px rgba(244,63,94,.9);transition:width .1s linear}
nav.top{position:sticky;top:0;z-index:60;background:color-mix(in srgb,var(--bg) 72%,transparent);
  backdrop-filter:blur(var(--blur)) saturate(150%);-webkit-backdrop-filter:blur(var(--blur)) saturate(150%);
  border-bottom:1px solid var(--line)}
.navin{max-width:1160px;margin:0 auto;padding:13px 30px;display:flex;gap:15px;align-items:center}
.mark{display:flex;align-items:baseline;gap:9px;white-space:nowrap}
.mark .en{font-weight:800;font-size:18px;letter-spacing:-.03em}
.mark .ar{font-family:'Noto Kufi Arabic',serif;font-size:15px;opacity:.55}
.search{flex:1;position:relative;min-width:110px}
.search input{width:100%;padding:11px 15px 11px 41px;border-radius:999px;color:var(--ink);
  border:1px solid var(--line);background:var(--surface);backdrop-filter:blur(10px);
  font:500 14px 'Plus Jakarta Sans',sans-serif;transition:box-shadow .25s,border-color .25s}
.search input::placeholder{color:var(--muted)}
.search input:focus{outline:none;border-color:transparent;
  box-shadow:0 0 0 1.5px var(--v1),0 0 26px rgba(244,63,94,.35)}
.search .ico{position:absolute;left:15px;top:50%;transform:translateY(-50%);width:16px;opacity:.5}
.search kbd{position:absolute;right:13px;top:50%;transform:translateY(-50%);padding:2px 7px;
  border:1px solid var(--line);border-radius:6px;color:var(--muted);
  font:500 11px 'JetBrains Mono',monospace}
.ib{width:41px;height:41px;flex-shrink:0;display:grid;place-items:center;cursor:pointer;
  border-radius:13px;border:1px solid var(--line);background:var(--surface);color:var(--ink);
  transition:transform .22s cubic-bezier(.2,.9,.3,1.3),box-shadow .22s,border-color .22s}
.ib:hover{transform:translateY(-3px);border-color:var(--v2);box-shadow:var(--shadow)}
.ib:focus-visible{outline:2px solid var(--v1);outline-offset:2px}
.ico{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.ico.big{width:32px;height:32px}
.mark{cursor:pointer;background:none;border:0;padding:0;color:inherit;font:inherit}
.mark:focus-visible{outline:2px solid var(--v1);outline-offset:4px;border-radius:8px}
.chiprail{position:relative}
.chiprail::before,.chiprail::after{content:'';position:absolute;top:0;bottom:12px;width:44px;
  pointer-events:none;z-index:2;opacity:0;transition:opacity .3s}
.chiprail::before{left:0;background:linear-gradient(90deg,var(--bg),transparent)}
.chiprail::after{right:0;background:linear-gradient(270deg,var(--bg),transparent)}
.chiprail.more-l::before,.chiprail.more-r::after{opacity:.9}
.chips{display:flex;gap:8px;overflow-x:auto;max-width:1160px;margin:0 auto;
  padding:0 30px 12px;scrollbar-width:none;scroll-behavior:smooth}
.chips::-webkit-scrollbar{display:none}
.chip{flex-shrink:0;display:flex;gap:7px;align-items:center;padding:7px 14px;border-radius:999px;
  border:1px solid var(--line);background:var(--surface);color:var(--muted);text-decoration:none;
  font:500 12.5px 'Plus Jakarta Sans',sans-serif;white-space:nowrap;
  transition:transform .22s,color .22s,border-color .22s}
.chip b{font:600 11px 'JetBrains Mono',monospace;color:var(--v1)}
.chip:hover{transform:translateY(-2px);color:var(--ink);border-color:var(--v1)}
.chip:focus-visible{outline:2px solid var(--v1);outline-offset:3px;color:var(--ink)}
.tile:focus-visible,.toc a:focus-visible{outline:2px solid var(--v1);outline-offset:3px}
.chip.active{background:var(--grad);border-color:transparent;color:#fff}
.chip.active b{color:rgba(255,255,255,.82)}

/* ---------- hero ---------- */
header.hero{padding:92px 0 70px;position:relative}
.pill{display:inline-flex;gap:9px;align-items:center;padding:8px 17px;border-radius:999px;
  font:600 12.5px 'Plus Jakarta Sans',sans-serif;color:var(--muted);margin-bottom:30px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--v1);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(244,63,94,.6)}50%{box-shadow:0 0 0 8px rgba(244,63,94,0)}}
h1{font-size:clamp(46px,8.6vw,104px);line-height:.94;letter-spacing:-.05em;font-weight:800;margin:0 0 22px}
.lockup{display:flex;align-items:center;gap:clamp(14px,2.4vw,30px)}
.lockup .en{flex-shrink:0}
.lockup .rule{flex:1;height:2px;min-width:20px;border-radius:1px;background:var(--grad);
  background-size:220% 100%;opacity:.55;animation:shift 9s ease-in-out infinite alternate}
.lockup .ar{flex-shrink:0;font-family:'Noto Kufi Arabic',serif;font-weight:700;
  font-size:.72em;line-height:1;letter-spacing:0;color:var(--ink);opacity:.42}
.hero .stand{font-size:clamp(16px,2.3vw,21px);color:var(--muted);max-width:58ch;margin:0 0 40px}
.hero-banner{margin:0 0 40px;padding:clamp(10px,2vw,22px);border-radius:26px;
  background:var(--surface);border:1px solid var(--line);
  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  box-shadow:0 40px 90px -50px rgba(0,0,0,.85);will-change:transform;overflow:hidden}
.hero-banner svg.hb{display:block;width:100%;height:auto}
@keyframes hbFloat{50%{transform:translateY(-9px)}}
@keyframes hbDash{to{stroke-dashoffset:-44}}
@keyframes hbRing{0%,100%{opacity:.7;transform:scale(1)}50%{opacity:.25;transform:scale(1.09)}}
@keyframes hbRing2{0%,100%{opacity:.28;transform:scale(1)}50%{opacity:.05;transform:scale(1.14)}}
@keyframes hbGen{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes hbGrow{0%,100%{transform:scaleX(1)}50%{transform:scaleX(1.14)}}
.hb g,.hb rect,.hb circle{transform-box:fill-box;transform-origin:center}
.hb .hb-f1{animation:hbFloat 7s ease-in-out infinite}
.hb .hb-f2{animation:hbFloat 5.6s ease-in-out infinite -1.4s}
.hb .hb-f3{animation:hbFloat 8.2s ease-in-out infinite -3s}
.hb .hb-dash{animation:hbDash 2.4s linear infinite}
.hb .hb-ring{animation:hbRing 4s ease-in-out infinite}
.hb .hb-ring2{animation:hbRing2 4s ease-in-out infinite -.6s}
.hb .hb-grow{transform-origin:left center;animation:hbGrow 6s ease-in-out infinite}
.hb .hb-gen1{animation:hbGen 3.2s ease-in-out infinite}
.hb .hb-gen2{animation:hbGen 3.2s ease-in-out infinite -1.05s}
.hb .hb-gen3{animation:hbGen 3.2s ease-in-out infinite -2.1s}
.bento{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:14px;margin-bottom:38px}
.kpi{padding:24px;border-radius:20px;transition:transform .3s cubic-bezier(.2,.9,.3,1.3),box-shadow .3s}
.kpi:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.kpi .n{font-size:40px;font-weight:800;line-height:1;letter-spacing:-.04em;
  background:var(--grad-warm);-webkit-background-clip:text;background-clip:text;color:transparent}
.kpi .l{font-size:12.5px;color:var(--muted);font-weight:500;margin-top:9px}
.meta{display:flex;gap:28px;flex-wrap:wrap;font:500 12px 'JetBrains Mono',monospace;color:var(--muted)}
.meta i{font-style:normal;color:var(--ink)}

/* ---------- module map (bento) ---------- */
.map{display:grid;grid-template-columns:repeat(auto-fill,minmax(228px,1fr));gap:13px}
.tile{display:flex;flex-direction:column;gap:5px;padding:20px;border-radius:18px;text-decoration:none;
  color:var(--ink);background:var(--surface);border:1px solid var(--line);
  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  transition:transform .3s cubic-bezier(.2,.9,.3,1.3),border-color .3s,box-shadow .3s;transition-delay:0s}
.tile:hover{transform:translateY(-6px) scale(1.02);border-color:transparent;box-shadow:var(--shadow)}
.tnum{font:700 11px 'JetBrains Mono',monospace;color:var(--v1)}
.tname{font-weight:700;font-size:15.5px;letter-spacing:-.015em}
.tcount{font-size:12px;color:var(--muted)}
.tarrow{margin-top:8px;opacity:0;transform:translateX(-6px);transition:.3s;color:var(--v2)}
.tile:hover .tarrow{opacity:1;transform:none}

/* ---------- sections ---------- */
section.blk{padding:58px 0;position:relative;scroll-margin-top:var(--navh,108px)}
section.blk::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--line) 20%,var(--line) 80%,transparent)}
.eyebrow{font:500 12px 'JetBrains Mono',monospace;color:var(--v1);margin-bottom:10px}
h2{font-size:clamp(29px,4.2vw,44px);line-height:1.08;letter-spacing:-.035em;font-weight:800;margin:0 0 16px}
h3{font-size:22px;letter-spacing:-.02em;font-weight:700;margin:0}
p{margin:0 0 16px;max-width:74ch;color:var(--muted)}
p strong{color:var(--ink);font-weight:600}
.note{padding:20px 24px;border-radius:18px;margin:24px 0;max-width:none;font-size:14.5px;color:var(--muted);
  background:var(--surface);border:1px solid var(--line);border-left:2px solid transparent;
  border-image:var(--grad) 1;backdrop-filter:blur(var(--blur))}

/* ---------- modules ---------- */
.module{margin:26px 0;border-radius:26px;overflow:hidden;scroll-margin-top:var(--navh,108px);
  background:var(--surface);border:1px solid var(--line);
  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  transition:box-shadow .4s,border-color .4s}
.module:hover{box-shadow:var(--shadow)}
.module.dim{opacity:.22;filter:saturate(.3)}
.mhead{display:flex;gap:19px;align-items:center;padding:26px 28px;cursor:pointer}
.mbadge{width:50px;height:50px;flex-shrink:0;border-radius:16px;background:var(--grad);
  background-size:200% 100%;color:#fff;display:grid;place-items:center;font-weight:800;font-size:19px;
  box-shadow:0 10px 30px -12px rgba(168,85,247,.9);animation:shift 9s ease-in-out infinite alternate}
.mtitle{flex:1;min-width:0}
.mmeta{font:500 12px 'JetBrains Mono',monospace;color:var(--muted);margin-top:3px}
.fold{background:none;border:0;color:var(--muted);cursor:pointer;padding:9px;border-radius:11px;
  transition:transform .3s,background .25s,color .25s}
.fold:hover{background:rgba(244,63,94,.14);color:var(--v1)}
.fold[aria-expanded="false"]{transform:rotate(-90deg)}
.mbody{padding:0 28px 28px}
.module.closed .mbody{display:none}
.lede{font-size:16.5px}

/* ---------- tables ---------- */
.tw{overflow-x:auto;border-radius:18px;border:1px solid var(--line);margin:22px 0;
  background:color-mix(in srgb,var(--bg2) 60%,transparent)}
table{width:100%;border-collapse:collapse;font-size:14px;min-width:620px}
th{text-align:left;padding:15px 17px;border-bottom:1px solid var(--line);
  font:700 11.5px 'Plus Jakarta Sans',sans-serif;letter-spacing:.05em;color:var(--muted);
  background:color-mix(in srgb,var(--bg) 88%,transparent);position:sticky;top:0;z-index:1}
td{padding:14px 17px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.55}
tbody tr:last-child td{border-bottom:0}
tbody tr{transition:background .2s}
tbody tr:hover{background:rgba(168,85,247,.09)}
tr[hidden]{display:none}
.c-id{font:500 12px 'JetBrains Mono',monospace;width:106px;white-space:nowrap;color:var(--v1);cursor:copy}
.c-id:hover{color:var(--v2)}
.c-req{font-weight:600;width:222px;color:var(--ink)}
.c-def,.c-plan{color:var(--muted)}
.c-term{font-weight:600;width:222px;color:var(--ink)}
mark{background:linear-gradient(180deg,transparent 56%,rgba(251,191,36,.5) 56%);color:inherit;
  border-radius:2px;padding:0 2px}
.empty{text-align:center;padding:24px;font-size:14px}

/* ---------- figures + dropzones ---------- */
figure{margin:26px 0}
.figbox{border-radius:20px;padding:16px;background:var(--surface);border:1px solid var(--line);
  backdrop-filter:blur(var(--blur));will-change:transform}
.figbox svg{width:100%;height:auto;display:block}
figcaption{font-size:12.5px;color:var(--muted);margin-top:12px;display:flex;gap:12px;align-items:baseline}
.tag{font:500 11.5px 'JetBrains Mono',monospace;color:var(--v1);flex-shrink:0}
.ui-fig{margin:30px 0}
.uibox{border-radius:22px;padding:0;overflow:hidden;background:var(--surface);
  border:1px solid var(--line);backdrop-filter:blur(var(--blur));
  -webkit-backdrop-filter:blur(var(--blur));will-change:transform;
  box-shadow:0 30px 70px -40px rgba(0,0,0,.9)}
.uibar{display:flex;align-items:center;gap:7px;padding:11px 16px;border-bottom:1px solid var(--line);
  background:color-mix(in srgb,var(--bg2) 70%,transparent)}
.uidot{width:8px;height:8px;border-radius:50%;background:var(--line)}
.uibar em{margin-left:8px;font:500 10.5px 'JetBrains Mono',monospace;font-style:normal;color:var(--muted)}
.uibox svg.ui{display:block;width:100%;height:auto;padding:18px}
.uibox:hover{border-color:transparent}
.toast{position:fixed;left:50%;bottom:28px;z-index:90;padding:13px 24px;border-radius:999px;
  background:var(--grad);color:#fff;font:600 13px 'Plus Jakarta Sans',sans-serif;
  box-shadow:var(--shadow);opacity:0;transform:translate(-50%,90px);pointer-events:none;
  transition:transform .38s cubic-bezier(.2,.9,.3,1.4),opacity .3s}
.toast.show{opacity:1;transform:translate(-50%,0)}

footer{margin-top:64px;padding:40px 0;border-top:1px solid var(--line)}
footer .wrap{display:flex;justify-content:space-between;gap:22px;flex-wrap:wrap;
  font:500 12px 'JetBrains Mono',monospace;color:var(--muted)}

.rv{opacity:0;transform:translateY(26px);
  transition:opacity .75s cubic-bezier(.2,.7,.3,1),transform .75s cubic-bezier(.2,.7,.3,1);
  transition-delay:var(--d,0ms)}
.rv.in{opacity:1;transform:none}

@media (max-width:860px){
  .wrap{padding:0 18px}.navin{padding:11px 18px;gap:10px}.chips{padding:0 18px 10px}
  .mark .en{display:none}header.hero{padding:56px 0 40px}
  .lockup{gap:12px}.lockup .ar{font-size:.62em}
  .hero-banner{padding:8px;border-radius:18px}
  .mhead{padding:19px}.mbody{padding:0 19px 22px}
  .c-req,.c-term{width:auto}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}.rv{opacity:1;transform:none}
  [data-par]{transform:none!important}
}
@media print{
  .field,.mesh,nav.top,#bar,.toast,.fold,.map{display:none!important}
  body{background:#fff;color:#111}
  .module,.kpi,.note,.tw,.figbox,.uibox,.hero-banner{background:#fff;border:1px solid #ddd;box-shadow:none;backdrop-filter:none}
  .module.closed .mbody{display:block!important}
  .module,.fig,.ui-fig,.tw{page-break-inside:avoid}
  .rv{opacity:1!important;transform:none!important}
  .gt,.kpi .n,.drop-cta{color:#111!important;-webkit-text-fill-color:#111}
}
</style>
</head>
<body>
<div id="bar"></div>
<div class="field" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></div>
<div class="mesh" aria-hidden="true"></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<nav class="top">
  <div class="navin">
    <button class="mark" id="totop" title="Back to top" aria-label="Back to top">
      <span class="en gt">Lawha</span><span class="ar">لوحة</span></button>
    <div class="search">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Search 159 requirements…" aria-label="Search requirements">
      <kbd>/</kbd>
    </div>
    <button class="ib" id="expand" title="Expand or collapse all" aria-label="Expand or collapse all modules">
